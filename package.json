{
  "name": "infinite-canvas-mcp",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "description": "Stage-based infinite canvas knowledge and AI handoff engine",
  "engines": {
    "node": ">=22.0.0"
  },
  "scripts": {
    "start": "tsx src/index.ts",
    "mcp": "tsx src/mcp/server.ts",
    "build": "tsc",
    "typecheck": "tsc --noEmit",
    "test": "node --import tsx --test tests/*.test.ts",
    "test:e2e": "node --import tsx --test tests/web_e2e.test.ts",
    "test:install": "playwright install chromium"
  },
  "dependencies": {
    "@modelcontextprotocol/sdk": "^1.32.2",
    "express": "^5.3.0",
    "zod": "^4.6.7"
  },
  "devDependencies": {
    "@playwright/test": "^1.65.1",
    "@types/express": "^5.0.6",
    "@types/node": "^24.19.2",
    "tsx": "^4.23.15",
    "typescript": "^7.0.2"
  }
}
